config {
  type: "table",
  description: "Uma linha por produto por evento (UNNEST de items), com as chaves do evento",
  tags: ["staging"]
}

SELECT
  -- Chaves do evento. Sem ga_session_id de propósito: ler event_params custaria ~1,3 GiB a mais.
  -- Para ligar à sessão, use user_pseudo_id + event_datetime contra a stg_events.
  PARSE_DATE('%Y%m%d', event_date) AS event_date,
  TIMESTAMP_MICROS(event_timestamp) AS event_datetime,
  event_name AS event_name,
  user_pseudo_id AS user_pseudo_id,
  ecommerce.transaction_id AS transaction_id,

  -- Produto
  item.item_id AS item_id,
  item.item_name AS item_name,
  item.item_brand AS item_brand,
  item.item_variant AS item_variant,
  item.item_category AS item_category,
  item.price AS price,
  item.quantity AS quantity,
  item.item_revenue AS item_revenue,
  item.coupon AS item_coupon,

  -- Lista e banner interno
  item.item_list_name AS item_list_name,
  item.promotion_id AS promotion_id,
  item.promotion_name AS promotion_name,
  item.creative_name AS creative_name,
  item.creative_slot AS creative_slot

FROM ${ref("events_*")},
  UNNEST(items) AS item
WHERE _TABLE_SUFFIX BETWEEN '${dataform.projectConfig.vars.start_date}'
                        AND '${dataform.projectConfig.vars.end_date}'
